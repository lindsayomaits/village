{
  "expo": {
    "name": "VillageMates",
    "slug": "the-village-exchange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "babysitexchange",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7D9E8C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babysitexchange.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF8F3"
      },
      "package": "com.VillageMates"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E07B65"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eff1bd10-7756-49cd-b6fc-0e95ee55a8f1"
      }
    }
  }
}
