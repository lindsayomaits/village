{
  "expo": {
    "name": "VillageMates",
    "slug": "villagemates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "villagemates",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7D9E8C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.villagemates.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.villagemates.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7D9E8C"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "VillageMates uses your calendar to add help you've scheduled."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eff1bd10-7756-49cd-b6fc-0e95ee55a8f1"
      }
    }
  }
}
